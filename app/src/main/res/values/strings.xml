    <string name="instruction_title">How to export CSV from Garmin Connect</string>
    <string name="instruction_step_open">Open connect.garmin.com in a desktop browser and sign in.</string>
    <string name="instruction_step_activities">Go to Activities, then All Activities.</string>
    <string name="instruction_step_scroll">Scroll the list down to your oldest activity.</string>
    <string name="instruction_step_export">Click Export CSV in the top right corner.</string>
    <string name="instruction_step_save">Save the file, then transfer it to this phone.</string>
    <string name="instruction_warning_scroll">Only activities loaded on screen are exported. If you don\'t scroll to the end, the file will be incomplete.</string>
    <string name="instruction_warning_metric">Metric profile only \u2014 distances must be in kilometres.</string>
    <string name="instruction_warning_english">English Garmin Connect interface only \u2014 column names in other languages aren\'t recognised.</string>

    <string name="health_connect_not_connected_status">Not connected</string>
    <string name="health_connect_not_connected_explanation">Garmin Connect writes your workouts to Health Connect, the health storage built into Android. Connecting lets this app read them and fill your calendar by itself. Nothing is sent anywhere \u2014 all data stays on this phone.</string>
    <string name="health_connect_permissions_title">Android will ask for permission to read</string>
    <string name="health_connect_permission_workouts">workouts and their duration</string>
    <string name="health_connect_permission_distance">distance in kilometres</string>
    <string name="health_connect_permission_history">data older than 30 days</string>
    <string name="health_connect_permission_background">reading in the background \u2014 optional</string>
    <string name="health_connect_permission_background_note">Without background reading the app still works: it updates every time you open it.</string>
    <string name="health_connect_connect">Connect</string>
    <string name="health_connect_permissions_in_settings">Android shows that dialog only once. Any permission left out is granted in Health Connect settings \u2014 the app needs all four.</string>
    <string name="health_connect_open_settings">Open Health Connect settings</string>

    <string name="health_connect_unavailable_status">Not available on this phone</string>
    <string name="health_connect_unavailable_explanation">Health Connect isn\'t installed. On Android 13 and older it comes as a separate app.</string>
    <string name="health_connect_unavailable_warning_title">Installing it may not help</string>
    <string name="health_connect_unavailable_warning">Garmin Connect writes to Health Connect only on Android 14 and newer. On this phone automatic sync will stay empty even after installing.</string>
    <string name="health_connect_history_now_title">Get your history now</string>
    <string name="health_connect_history_now_explanation">A CSV export from Garmin Connect works on any Android version.</string>
    <string name="health_connect_import_csv">Import history from CSV</string>
